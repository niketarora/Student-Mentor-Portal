# =====================================================================
# .env.example  →  copy to .env  (repo root, SERVER-SIDE ONLY)
# =====================================================================
# These are read by the Vercel serverless functions in /api and by the
# seed script. They must NEVER be prefixed with VITE_ and must never end
# up in the browser bundle.
#
# On Vercel: Project → Settings → Environment Variables.
# =====================================================================

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → service_role (secret)
# Full database access, bypasses RLS. Treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Supabase → Project Settings → API Keys → anon / public
# Used server-side to make RLS-scoped calls on behalf of the caller.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Comma-separated origins allowed to call the API cross-origin.
# Same-origin deployments do not need this; set it if you host the
# frontend somewhere other than the API.
ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app

# Comma-separated email domains accounts may be created for.
# Leave blank to allow any domain.
ALLOWED_EMAIL_DOMAINS=jaipur.manipal.edu,muj.manipal.edu

# Password used by supabase/scripts/seed-demo-accounts.mjs
SEED_DEFAULT_PASSWORD=SsmpDemo@2026
