# ---------------------------------------------------------------------
# frontend/.env.example  →  copy to frontend/.env.local and fill in
# ---------------------------------------------------------------------
# Only VITE_* variables are exposed to the browser. Never put the
# service-role key here — it belongs in the root .env, server side only.
# ---------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → anon / public key.
# Safe to ship to the browser: it can only do what your RLS policies allow.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Base path for the Vercel serverless functions.
# Leave as /api for both local dev (via vercel dev) and production.
VITE_API_BASE_URL=/api

# Shown on the login screen and in report footers.
VITE_INSTITUTION_NAME=Manipal University Jaipur
VITE_DEPARTMENT_NAME=Department of IoT & Intelligent Systems
